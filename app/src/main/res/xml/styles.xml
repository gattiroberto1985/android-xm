<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Theme per SplashScreen (Material Design 3) -->
    <!-- Usato da MainActivity fino a setContent() -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Colore di sfondo dello splash -->
        <item name="windowSplashScreenBackground">@android:color/white</item>

        <!-- Logo/animazione dello splash (opzionale) -->
        <!-- <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item> -->

        <!-- Durata dell'animazione (ms) -->
        <!-- <item name="windowSplashScreenAnimationDuration">1000</item> -->

        <!-- Colore primario -->
        <item name="colorPrimary">@color/primary_color</item>
    </style>

    <!-- Theme principale dell'app (dopo splash) -->
    <style name="Theme.App" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="colorPrimary">@color/primary_color</item>
        <item name="colorPrimaryVariant">@color/primary_dark_color</item>
        <item name="colorSecondary">@color/secondary_color</item>
        <item name="colorSecondaryVariant">@color/secondary_dark_color</item>
        <item name="colorError">@color/error_color</item>
        <item name="colorBackground">@color/background_color</item>
        <item name="colorSurface">@color/surface_color</item>
    </style>

</resources>